# ============================================================================
# Plantilla de variables de entorno del NOC
# ----------------------------------------------------------------------------
# Copia este archivo a ".env" y reemplaza los valores de ejemplo.
#   cp .env.template .env
#
# TODAS las variables son obligatorias (se validan con env-var en
# src/config/plugins/envs.plugin.ts). Si falta alguna, el proceso NO arranca.
# La única con valor por defecto es NOC_CONFIG_URL.
# ============================================================================


# ----------------------------------------------------------------------------
# CORREO (nodemailer) — envío de alertas y del resumen de logs
# ----------------------------------------------------------------------------

# Proveedor/servicio de correo que usa nodemailer. Para Gmail se deja "gmail".
# Otros valores posibles según nodemailer: "hotmail", "outlook365", etc.
MAILER_SERVICE=gmail

# Dirección desde la que se envían los correos. DEBE ser un email válido
# (se valida con .asEmailString()). Para Gmail, es la cuenta dueña del
# app-password de abajo.
MAILER_EMAIL=tu-correo@gmail.com

# Contraseña de aplicación (NO tu contraseña normal de Gmail).
# Se genera en: Cuenta de Google → Seguridad → Verificación en 2 pasos →
# Contraseñas de aplicaciones. Sin un valor real la app igual arranca, pero
# los correos fallarán al enviarse.
MAILER_SECRET_KEY=tu-app-password


# ----------------------------------------------------------------------------
# MONGODB — uno de los tres backends donde se guardan los logs
# ----------------------------------------------------------------------------

# Cadena de conexión completa a MongoDB.
# Formato: mongodb://<usuario>:<password>@<host>:<puerto>
# Usa 127.0.0.1 (IPv4) en vez de "localhost": en algunos equipos "localhost"
# resuelve solo a IPv6 (::1) y el loopback IPv6 puede dar timeouts al
# apagar/encender el wifi. El usuario y password deben coincidir con
# MONGO_USER / MONGO_PASS (los usa el contenedor de docker-compose).
MONGO_URL=mongodb://mongo-user:123456@127.0.0.1:27017

# Nombre de la base de datos de Mongo que usará la app.
MONGO_DB_NAME=NOC

# Usuario root con el que se inicializa el contenedor de Mongo
# (docker-compose lo lee como MONGO_INITDB_ROOT_USERNAME).
# Debe ser el mismo usuario que aparece en MONGO_URL.
MONGO_USER=mongo-user

# Password del usuario root de Mongo
# (docker-compose lo lee como MONGO_INITDB_ROOT_PASSWORD).
# Debe ser el mismo password que aparece en MONGO_URL.
MONGO_PASS=123456


# ----------------------------------------------------------------------------
# POSTGRESQL — otro de los tres backends (vía Prisma)
# ----------------------------------------------------------------------------

# Usuario de PostgreSQL (docker-compose lo lee como POSTGRES_USER).
# Debe coincidir con el usuario de DATABASE_URL.
POSTGRES_USER=postgres

# Nombre de la base de datos de Postgres (docker-compose: POSTGRES_DB).
# Debe coincidir con el nombre al final de DATABASE_URL.
POSTGRES_DB=NOC

# Password de PostgreSQL (docker-compose: POSTGRES_PASSWORD).
# Debe coincidir con el password de DATABASE_URL.
POSTGRES_PASSWORD=123456

# Cadena de conexión que usa Prisma para conectarse a Postgres.
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<bd>?schema=public
# - Puerto 5430: el contenedor publica Postgres en el 5430 del host (mapeado
#   al 5432 interno) para no chocar con una instancia local de Odoo en el 5432.
# - 127.0.0.1: misma razón que en MONGO_URL (forzar IPv4, evitar timeouts).
# - Usuario, password y nombre de BD deben coincidir con las tres variables
#   POSTGRES_* de arriba.
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5430/NOC?schema=public


# ----------------------------------------------------------------------------
# INTEGRACIÓN CON ODOO — origen de los dominios y correos a monitorear
# ----------------------------------------------------------------------------

# URL del endpoint del módulo de Odoo (noc_monitoring) que devuelve, en JSON,
# los dominios activos con sus correos. El NOC lo consulta al arrancar y lo
# recarga cada 5 minutos.
# - Ajusta el puerto al de tu instancia de Odoo (8069 por defecto; aquí 8080).
# - 127.0.0.1: forzar IPv4, igual que las demás conexiones locales.
# - Es la ÚNICA variable opcional: si se omite, usa por defecto
#   http://localhost:8069/noc/config (ver envs.plugin.ts).
NOC_CONFIG_URL=http://127.0.0.1:8080/noc/config
